-- THREAD DO ESP (Otimizada p/ Celular)
-- ============================================
task.spawn(function()
    while task.wait(0.1) do
        if flags.espNames or flags.espChams then
            for _, plr in ipairs(Mono.plrs) do
                if plr ~= LocalPlayer and alive(plr) then
                    local e = ensureEsp(plr)
                    local role = roleOf(plr)
                    local col = espColor(role)
                    
                    if flags.espChams then
                        e.hl.Adornee = plr.Character; e.hl.OutlineColor = col; e.hl.FillColor = col; e.hl.Enabled = true
                    else e.hl.Enabled = false end

                    if flags.espNames then
                        e.bb.Adornee = plr.Character:FindFirstChild("Head") or getHRP(plr.Character)
                        local dist = math.floor((getHRP(plr.Character).Position - Camera.CFrame.Position).Magnitude)
                        local nm = plr.Name
                        if flags.espRoleTags then nm = tagOf(role) .. " " .. nm end
                        e.name.Text = nm; e.sub.Text = dist .. "m"
                        e.name.TextColor3 = col; e.edge.Color = col
                        e.bb.Enabled = (flags.espMaxDist <= 0 or dist <= flags.espMaxDist)
                    else e.bb.Enabled = false end
                elseif espStore[plr] then
                    espStore[plr].hl.Enabled = false; espStore[plr].bb.Enabled = false
                end
            end
        end
    end
end)

-- Box ESP
local boxStore = {}
task.spawn(function()
    while task.wait(0.05) do
        if flags.espBox then
            for _, plr in ipairs(Mono.plrs) do
                if plr ~= LocalPlayer and alive(plr) then
                    if not boxStore[plr] then boxStore[plr] = {Mono.newLine(1), Mono.newLine(1), Mono.newLine(1), Mono.newLine(1)} end
                    local hrp = getHRP(plr.Character)
                    local v, on = Camera:WorldToViewportPoint(hrp.Position)
                    if on then
                        local size = 2500 / v.Z
                        local b = boxStore[plr]
                        b[1].From, b[1].To = Vector2.new(v.X - size/2, v.Y - size/2), Vector2.new(v.X + size/2, v.Y - size/2)
                        b[2].From, b[2].To = Vector2.new(v.X + size/2, v.Y - size/2), Vector2.new(v.X + size/2, v.Y + size/2)
                        b[3].From, b[3].To = Vector2.new(v.X + size/2, v.Y + size/2), Vector2.new(v.X - size/2, v.Y + size/2)
                        b[4].From, b[4].To = Vector2.new(v.X - size/2, v.Y + size/2), Vector2.new(v.X - size/2, v.Y - size/2)
                        for i=1,4 do b[i].Color = espColor(roleOf(plr)); b[i].Visible = true end
                    else for i=1,4 do boxStore[plr][i].Visible = false end end
                end
            end
        end
    end
end)

