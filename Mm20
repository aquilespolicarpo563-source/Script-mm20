local function findWeapon(n)
    local ch = LocalPlayer.Character; local bp = LocalPlayer:FindFirstChild("Backpack")
    return (ch and ch:FindFirstChild(n)) or (bp and bp:FindFirstChild(n))
end
local function equip(tool)
    local ch = LocalPlayer.Character; local hum = ch and ch:FindFirstChildOfClass("Humanoid")
    if tool and hum and tool.Parent ~= ch then pcall(function() hum:EquipTool(tool) end) end
end
local function getMurderer()
    for _, plr in ipairs(Mono.plrs) do if plr ~= LocalPlayer and roleOf(plr) == "Murderer" then return plr end end
end
local function canAct()
    local ch = LocalPlayer.Character
    return ch and ch:FindFirstChild("Humanoid") and ch.Humanoid.Health > 0
end

local function updateTriggerbot()
    if not flags.Triggerbot or not canAct() then return end
    local char = LocalPlayer.Character; local gun, shootRemote
    for _, tool in ipairs(char:GetChildren()) do if tool:IsA("Tool") and tool:FindFirstChild("Shoot") then gun = tool; shootRemote = tool.Shoot; break end end
    if not gun or not shootRemote then return end
    local hrp = char:FindFirstChild("HumanoidRootPart"); local attachment = hrp and hrp:FindFirstChild("GunRaycastAttachment")
    if not attachment then return end
    local murder = getMurderer(); if not murder or not murder.Character then return end
    local params = RaycastParams.new(); params.FilterType = Enum.RaycastFilterType.Exclude; params.FilterDescendantsInstances = {char, Camera}
    local cameraRay = workspace:Raycast(Camera.CFrame.Position, Camera.CFrame.LookVector * 1000, params)
    if cameraRay and cameraRay.Instance:IsDescendantOf(murder.Character) then
        local gunRay = workspace:Raycast(attachment.WorldPosition, cameraRay.Position - attachment.WorldPosition, params)
        if gunRay and gunRay.Instance:IsDescendantOf(murder.Character) then
            local now = tick(); if now - lastShot >= 0.15 then lastShot = now; pcall(function() shootRemote:FireServer(attachment.WorldCFrame, CFrame.new(cameraRay.Position)) end) end
        end
    end
end

local function knifeKill(ev, tChar)
    if not (ev and tChar) then return end
    local ht = ev:FindFirstChild("HandleTouched"); local ks = ev:FindFirstChild("KnifeStabbed")
    if ks then ks:FireServer() end
    if ht then for _, pn in ipairs({"HumanoidRootPart", "UpperTorso", "Head"}) do local p = tChar:FindFirstChild(pn); if p then ht:FireServer(p); return end end end
end

local function snapShot(target)
    if snapping then return false end
    local gun = findWeapon("Gun"); local shoot = gun and gun:FindFirstChild("Shoot")
    local myHrp = getHRP(LocalPlayer.Character); local tChar = target and target.Character
    if not (gun and shoot and myHrp and tChar and canAct()) then return false end
    snapping = true; local home = myHrp.CFrame
    pcall(function()
        equip(gun); task.wait(0.1)
        local chest = (tChar:FindFirstChild("UpperTorso") or tChar:FindFirstChild("HumanoidRootPart")).Position
        local t0 = os.clock()
        while os.clock() - t0 < 0.15 do
            local h = getHRP(LocalPlayer.Character)
            if h and tChar.Parent then h.CFrame = CFrame.new(chest + Vector3.new(0, 5, 0), chest); h.AssemblyLinearVelocity = Vector3.zero end
            RunService.Heartbeat:Wait()
        end
        local hrp = getHRP(LocalPlayer.Character); local att = hrp and hrp:FindFirstChild("GunRaycastAttachment")
        if att then shoot:FireServer(att.WorldCFrame, CFrame.new(chest)); task.wait(0.1) end
    end)
    local h3 = getHRP(LocalPlayer.Character); if h3 then h3.CFrame = home end
    snapping = false; return true
end

pcall(function()
    local oldNamecall
    oldNamecall = hookmetamethod(game, "__namecall", newcclosure(function(self, ...)
        if not checkcaller() and getnamecallmethod() == "FireServer" then
            local nm = self.Name
            if nm == "Shoot" or nm == "KnifeThrown" then
                local target = nil
                if flags.SilentAim then
                    for _, p in ipairs(Mono.plrs) do if p ~= LocalPlayer and alive(p) and roleOf(p) == "Murderer" then target = p.Character:FindFirstChild("UpperTorso") or p.Character:FindFirstChild("HumanoidRootPart"); break end end
                end
                if target then local args = {...}; if #args >= 2 and typeof(args[2]) == "CFrame" then args[2] = CFrame.new(target.Position); return oldNamecall(self, table.unpack(args, 1, #args)) end end
            end
        end
        return oldNamecall(self, ...)
    end))
end)

RunService.Stepped:Connect(function()
    if flags.Noclip then
        local char = LocalPlayer.Character
        if char then for _, p in ipairs(char:GetDescendants()) do if p:IsA("BasePart") then p.CanCollide = false end end end
    end
    if flags.Fly and flyBV and flyBG then
        local hrp = getHRP(LocalPlayer.Character)
        if hrp then
            local dir = Vector3.zero
            if UserInputService:IsKeyDown(Enum.KeyCode.W) then dir += Camera.CFrame.LookVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.S) then dir -= Camera.CFrame.LookVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.A) then dir -= Camera.CFrame.RightVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.D) then dir += Camera.CFrame.RightVector end
            flyBV.Velocity = (dir.Magnitude > 0 and dir.Unit or Vector3.zero) * 60
            flyBG.CFrame = Camera.CFrame
        end
    end
end)

