-- Sistema de Cargos
local function computeRole(plr)
    local ch = plr.Character
    local bp = plr:FindFirstChild("Backpack")
    if ch then
        if ch:FindFirstChild("Knife") or (bp and bp:FindFirstChild("Knife")) then return "Murderer"
        elseif ch:FindFirstChild("Gun") or (bp and bp:FindFirstChild("Gun")) then return "Sheriff" end
    end
    return "Innocent"
end
local roleCache, cacheStamp = {}, 0
local function roleOf(plr)
    if os.clock() - cacheStamp > 0.1 then table.clear(roleCache); cacheStamp = os.clock() end
    if roleCache[plr] == nil then roleCache[plr] = computeRole(plr) end
    return roleCache[plr]
end
local function isGunRole(r) return r == "Sheriff" or r == "Hero" end
local function alive(plr)
    local ch = plr.Character; local h = ch and ch:FindFirstChild("Humanoid")
    return ch and h and h.Health > 0 and getHRP(ch) ~= nil
end

-- Nametags (Cards)
local espStore = {}
local function ensureEsp(plr)
    if espStore[plr] then return espStore[plr] end
    local e = {}
    e.hl = Instance.new("Highlight", EspGui)
    e.hl.FillTransparency = 1; e.hl.OutlineTransparency = 0; e.hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop; e.hl.Enabled = false
    
    e.bb = Instance.new("BillboardGui", EspGui)
    e.bb.Size = UDim2.fromOffset(180, 35); e.bb.AlwaysOnTop = true; e.bb.Enabled = false; e.bb.StudsOffsetWorldSpace = Vector3.new(0, 3, 0)
    
    e.card = Instance.new("Frame", e.bb)
    e.card.AnchorPoint = Vector2.new(0.5, 1); e.card.Position = UDim2.fromScale(0.5, 1)
    e.card.Size = UDim2.fromScale(1, 1); e.card.BackgroundColor3 = Color3.fromRGB(16, 16, 18)
    e.card.BackgroundTransparency = 0.3; e.card.BorderSizePixel = 0
    Instance.new("UICorner", e.card).CornerRadius = UDim.new(0, 6)
    
    e.edge = Instance.new("UIStroke", e.card); e.edge.Transparency = 0.75
    e.name = Instance.new("TextLabel", e.card)
    e.name.BackgroundTransparency = 1; e.name.Position = UDim2.new(0, 10, 0.5, 0); e.name.Size = UDim2.new(1, -90, 0, 15)
    e.name.Font = Enum.Font.GothamBold; e.name.TextSize = 12; e.name.TextXAlignment = Enum.TextXAlignment.Left
    
    e.sub = Instance.new("TextLabel", e.card)
    e.sub.BackgroundTransparency = 1; e.sub.AnchorPoint = Vector2.new(1, 0.5); e.sub.Position = UDim2.new(1, -10, 0.5, 0)
    e.sub.Size = UDim2.fromOffset(60, 14); e.sub.Font = Enum.Font.Gotham; e.sub.TextSize = 11; e.sub.TextXAlignment = Enum.TextXAlignment.Right
    
    espStore[plr] = e
    return e
end
local function espColor(role)
    if role == "Murderer" then return Color3.fromRGB(255, 80, 80)
    elseif isGunRole(role) then return Color3.fromRGB(90, 150, 255)
    else return Color3.fromRGB(95, 225, 125) end
end
local function tagOf(role) return role == "Murderer" and "[M]" or isGunRole(role) and "[S]" or "[I]" end

