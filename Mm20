local Mono = { plrs = {}, bodyCache = setmetatable({}, {__mode = "k"}), hasDrawing = false }
local EspGui = Instance.new("ScreenGui", game:GetService("CoreGui"))
EspGui.Name = "MonoESP"

pcall(function() local tl = Drawing.new("Line"); tl:Remove(); Mono.hasDrawing = true end)
Mono.newLine = function(t)
    if Mono.hasDrawing then local l = Drawing.new("Line"); l.Thickness = t; l.Transparency = 1; l.Visible = false; return l end
    return { Visible = false, Remove = function() end, From = Vector2.new(0,0), To = Vector2.new(0,0), Color = Color3.new(1,1,1) }
end

local function getHRP(ch) return ch and ch:FindFirstChild("HumanoidRootPart") end
local function refreshPlrs() local ok, l = pcall(function() return Players:GetPlayers() end); if ok then Mono.plrs = l end end
refreshPlrs()
Players.PlayerAdded:Connect(refreshPlrs)
Players.PlayerRemoving:Connect(function() task.defer(refreshPlrs) end)

local function computeRole(plr)
    local ch = plr.Character; local bp = plr:FindFirstChild("Backpack")
    if ch then
        if ch:FindFirstChild("Knife") or (bp and bp:FindFirstChild("Knife")) then return "Murderer"
        elseif ch:FindFirstChild("Gun") or (bp and bp:FindFirstChild("Gun")) then return "Sheriff" end
    end
    return "Innocent"
end
local roleCache, cacheStamp = {}, 0
local function roleOf(plr)
    if os.clock() - cacheStamp > 0.1 then table.clear(roleCache); cacheStamp = os.clock() end
    if roleCache[plr] == nil then roleCache[plr] = computeRole(plr) end
    return roleCache[plr]
end
local function isGunRole(r) return r == "Sheriff" or r == "Hero" end
local function alive(plr)
    local ch = plr.Character; local h = ch and ch:FindFirstChild("Humanoid")
    return ch and h and h.Health > 0 and getHRP(ch) ~= nil
end

local espStore = {}
local function ensureEsp(plr)
    if espStore[plr] then return espStore[plr] end
    local e = {}
    e.hl = Instance.new("Highlight", EspGui); e.hl.FillTransparency = 1; e.hl.OutlineTransparency = 0; e.hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop; e.hl.Enabled = false
    e.bb = Instance.new("BillboardGui", EspGui); e.bb.Size = UDim2.fromOffset(180, 30); e.bb.AlwaysOnTop = true; e.bb.Enabled = false; e.bb.StudsOffsetWorldSpace = Vector3.new(0, 3, 0)
    e.name = Instance.new("TextLabel", e.bb); e.name.BackgroundTransparency = 1; e.name.Size = UDim2.new(1, 0, 0.5, 0); e.name.Font = Enum.Font.GothamBold; e.name.TextSize = 13; e.name.TextStrokeTransparency = 0.5; e.name.TextXAlignment = Enum.TextXAlignment.Center
    e.sub = Instance.new("TextLabel", e.bb); e.sub.BackgroundTransparency = 1; e.sub.Position = UDim2.new(0, 0, 0.5, 0); e.sub.Size = UDim2.new(1, 0, 0.5, 0); e.sub.Font = Enum.Font.Gotham; e.sub.TextSize = 11; e.sub.TextStrokeTransparency = 0.5; e.sub.TextXAlignment = Enum.TextXAlignment.Center
    espStore[plr] = e
    return e
end
local function espColor(role)
    if role == "Murderer" then return Color3.fromRGB(255, 80, 80)
    elseif isGunRole(role) then return Color3.fromRGB(90, 150, 255)
    else return Color3.fromRGB(95, 225, 125) end
end
local function tagOf(role) return role == "Murderer" and "[M]" or isGunRole(role) and "[S]" or "[I]" end

-- Thread ESP
task.spawn(function()
    while task.wait(0.1) do
        if flags.espNames or flags.espChams then
            for _, plr in ipairs(Mono.plrs) do
                if plr ~= LocalPlayer and alive(plr) then
                    local e = ensureEsp(plr)
                    local role = roleOf(plr); local col = espColor(role)
                    if flags.espChams then e.hl.Adornee = plr.Character; e.hl.OutlineColor = col; e.hl.FillColor = col; e.hl.Enabled = true else e.hl.Enabled = false end
                    if flags.espNames then
                        e.bb.Adornee = plr.Character:FindFirstChild("Head") or getHRP(plr.Character)
                        local dist = math.floor((getHRP(plr.Character).Position - Camera.CFrame.Position).Magnitude)
                        local nm = plr.Name; if flags.espRoleTags then nm = tagOf(role) .. " " .. nm end
                        e.name.Text = nm; e.sub.Text = dist .. "m"; e.name.TextColor3 = col; e.sub.TextColor3 = col; e.bb.Enabled = true
                    else e.bb.Enabled = false end
                elseif espStore[plr] then espStore[plr].hl.Enabled = false; espStore[plr].bb.Enabled = false end
            end
        else
            for p, e in pairs(espStore) do e.hl.Enabled = false; e.bb.Enabled = false end
        end
    end
end)

-- Box ESP
local boxStore = {}
task.spawn(function()
    while task.wait(0.05) do
        if flags.espBox then
            for _, plr in ipairs(Mono.plrs) do
                if plr ~= LocalPlayer and alive(plr) then
