end)

Mono.newLine = function(t)
    if Mono.hasDrawing then
        local l = Drawing.new("Line")
        l.Thickness = t; l.Transparency = 1; l.Visible = false
        return l
    end
    return { Visible = false, Remove = function() end, From = Vector2.new(0,0), To = Vector2.new(0,0), Color = Color3.new(1,1,1) }
end

local function getHRP(ch) return ch and ch:FindFirstChild("HumanoidRootPart") end
